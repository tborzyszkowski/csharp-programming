graph LR
    A["Static Field"] --> B["Mutable"]
    A --> C["Not lazy"]
    
    D["Static Property"] --> E["Getter/Setter"]
    D --> F["Control"]
    
    G["Lazy<T>"] --> H["Thread-safe"]
    G --> I["Initialized on first access"]
    
    J["Static Readonly"] --> K["Immutable"]
    J --> L["Constants"]
    
    style G fill:#90EE90
    style H fill:#FFD700
    style I fill:#FFD700
