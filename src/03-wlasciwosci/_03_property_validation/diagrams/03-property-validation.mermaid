graph LR
    A["Walidacja"]
    
    B["Throw Exception<br/>Fail Fast"]
    C["Silent Ignore<br/>Soft Fail"]
    
    A --> B
    A --> C
    
    B --> B1["Krytyczne błędy"]
    B --> B2["throw new ArgumentException"]
    
    C --> C1["Aktualizacje opcionalne"]
    C --> C2["Nie zmienia wartości"]
    
    D["Events"]
    D --> D1["PropertyChanged"]
    D --> D2["Logowanie zmian"]
    
    style A fill:#e3f2fd
    style B fill:#ffebee
    style C fill:#e8f5e9
