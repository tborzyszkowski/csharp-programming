@model Project

@{
    Layout = "_Layout";
    ViewData["Title"] = "Nowy Projekt";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1>Utwórz Nowy Projekt</h1>

            <form asp-action="Create" asp-controller="Projects" method="post" novalidate>
                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Nazwa projektu -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Nazwa Projektu *</label>
                    <input asp-for="Name" class="form-control" placeholder="np. System CRM">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Opis projektu -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Opis</label>
                    <textarea asp-for="Description" class="form-control" rows="4" 
                              placeholder="Opisz cele i zakres projektu..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Data rozpoczęcia -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">Data Rozpoczęcia *</label>
                        <input asp-for="StartDate" type="date" class="form-control">
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <!-- Data zakończenia -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">Data Zakończenia</label>
                        <input asp-for="EndDate" type="date" class="form-control">
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Postęp -->
                <div class="mb-3">
                    <label asp-for="ProgressPercentage" class="form-label">Postęp (%)</label>
                    <input asp-for="ProgressPercentage" type="range" min="0" max="100" class="form-range">
                    <small class="text-muted" id="progressDisplay">0%</small>
                    <span asp-validation-for="ProgressPercentage" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="mb-3">
                    <label asp-for="Status" class="form-label">Status *</label>
                    <select asp-for="Status" class="form-select">
                        <option value="@ProjectStatus.Active">Aktywny</option>
                        <option value="@ProjectStatus.OnHold">Wstrzymany</option>
                        <option value="@ProjectStatus.Completed">Ukończony</option>
                    </select>
                </div>

                <!-- Przyciski -->
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Utwórz Projekt</button>
                    <a href="@Url.Action("Index", "Projects")" class="btn btn-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const progressInput = document.querySelector('input[name="ProgressPercentage"]');
        const progressDisplay = document.getElementById('progressDisplay');
        
        progressInput.addEventListener('input', function() {
            progressDisplay.textContent = this.value + '%';
        });
    </script>
}
