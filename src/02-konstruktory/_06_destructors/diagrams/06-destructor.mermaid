graph LR
    A["Destruktor<br/>~ClassName"] --> B["Finalizer<br/>Nie-deterministyczny"]
    
    C["IDisposable"] --> D["Dispose()<br/>Deterministyczny"]
    D --> E["GC.SuppressFinalize"]
    
    B --> F["Garbage Collection"]
    E --> F
    
    style A fill:#e3f2fd
    style C fill:#f3e5f5
    style F fill:#fff3e0
