graph TB
    A["Object Initializer<br/>new T { prop = val }"] --> B["Inicjalizuje właściwości<br/>Po konstruktorze"]
    C["Collection Initializer<br/>new List<T> { item }"] --> D["Dodaje elementy<br/>Konstruktor + Add"]
    E["Nested<br/>new A { B = new() }"] --> F["Kombinuje oba"]
    
    B --> G["Czytaj kod<br/>Bez dodatkowych linii"]
    D --> G
    F --> G
    
    style A fill:#e3f2fd
    style C fill:#f3e5f5
    style E fill:#e8f5e9
